MODEL HFP17
REFERENCE local
    REGISTER Q17
    ADDRESSES J17 x J17
    TARGET (4, 13)
FIELD A
    AMPLITUDE 1
    PHASE 0
FIELD B
    AMPLITUDE 1
    PHASE x - 4 MOD 17
FIELD C
    AMPLITUDE 1
    PHASE y - 13 MOD 17
COMPOSE coherent(A, B, C)
ACTIVATE
    WHERE intensity == 9
VERIFY
    GLOBAL_PHASE_INVARIANCE
    GALOIS_ACTIVATION_INVARIANCE
    REFERENCE_TRANSPORT
EXECUTION SIMULATION_ONLY
